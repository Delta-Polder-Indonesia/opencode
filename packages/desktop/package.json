    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "electron": "44.4.0",
    "electron-builder": "26.15.3",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "zod": "catalog:"
  }
}
