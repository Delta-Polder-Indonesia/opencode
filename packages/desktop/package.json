{
  "name": "@opencode-ai/desktop",
  "version": "1.18.31",
  "private": true,
  "type": "module",
  "description": "OpenCode desktop shell (Electron)",
  "license": "MIT",
  "author": "OpenCode contributors",
  "repository": {
    "type": "git",
